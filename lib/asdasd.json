inserted as (
  insert into public.casecraft_designs
    (seller_id, name, subtitle, image_url, case_type, models, price_lkr, is_new, is_bestseller, active, sort)
  select s.seller_id, d.name, d.subtitle, d.image_url, 'tough-cases', '{}', p.price,
true,
false,
true, d.sort
  from designs d
  cross join store s
  cross join params p
  where not exists (
    select 1 from public.casecraft_designs x
    where x.seller_id = s.seller_id and x.image_url = d.image_url
  )
  returning name
)
select
  (select count(*) from store)    as case_craft_store_found,   -- must be 1
  (select count(*) from inserted) as designs_added;            -- 43 the first time,
