# node-linker=hoisted makes pnpm lay out node_modules in a flat,
# non-symlinked structure (closer to npm/yarn classic) instead of its
# default node_modules/<pkg> -> .pnpm/<pkg>@<version>/node_modules/<pkg>
# symlink-into-a-virtual-store layout.
#
# Needed specifically because of Vercel's build error:
#   "The framework produced an invalid deployment package for a
#   Serverless Function. Typically this means that the framework
#   produces files in symlinked directories."
# That's pnpm's own default layout being described, not a bug in this
# project's code — Vercel's function packager can't reliably package a
# traced file (next.config.mjs's outputFileTracingIncludes, added to
# force-include playwright-core's browsers.json) that lives behind a
# symlink into pnpm's .pnpm virtual store. Flat/hoisted linking removes
# that indirection entirely, so the traced file is a real file at a
# predictable path instead.
#
# Trade-off: hoisting is pnpm's least strict mode — it allows a package
# to import another package it never listed as its own dependency (the
# "phantom dependency" problem npm/yarn classic both have too), which
# pnpm's default layout deliberately prevents. Acceptable here since the
# alternative is builds that don't deploy at all; revisit if a stricter
# layout becomes necessary later; some issue trackers instead recommend
# node-linker=hoisted alongside shamefully-hoist=true for older pnpm
# versions where hoisted alone doesn't fully flatten nested deps — add
# that too if playwright-core still can't resolve something after this.
node-linker=hoisted
